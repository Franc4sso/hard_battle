# Copia in .env.local (in locale) o impostala nelle variabili d'ambiente di Netlify.
GROQ_API_KEY=
# Facoltativo: modello Groq da usare.
GROQ_MODEL=openai/gpt-oss-120b
# Facoltativo: quanto ragiona il modello prima di narrare (low = più veloce, high = più curato).
GROQ_REASONING=low
# Facoltativo: segreto per firmare la prima parte della rissa (se manca si usa GROQ_API_KEY).
BATTLE_SECRET=

# Ritratti dei mostri con Cloudflare Workers AI (piano gratuito, ~170 immagini al giorno).
# Dashboard Cloudflare → AI → Workers AI → "Use REST API": account ID e token "Workers AI".
# Senza queste due variabili il gioco funziona uguale, solo senza ritratti.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Facoltativo: modello immagine (default @cf/black-forest-labs/flux-1-schnell).
CF_IMAGE_MODEL=
# Riserva quando la quota Cloudflare finisce: chiave secret di enter.pollinations.ai/keys
# (meglio con "Quest Pollen only", così non addebita mai). Senza, nessuna riserva.
POLLINATIONS_API_KEY=
# Facoltativo: modello Pollinations (default black-forest-labs/flux.1-schnell).
POLLINATIONS_IMAGE_MODEL=
# Facoltativo: modello Groq che traduce le carte in inglese per il ritratto (default openai/gpt-oss-20b).
PORTRAIT_TRANSLATE_MODEL=

POLLINATIONS_API_KEY=sk_tF7Cdp4JRIhseByOL5WjqVvHo3xCIf43


